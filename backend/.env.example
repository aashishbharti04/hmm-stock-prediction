# ----------------------------------------------------------------------------
# Backend configuration — copy to `.env` and adjust. NEVER commit a real .env.
# ----------------------------------------------------------------------------

# App
APP_NAME="HMM Stock Prediction API"
ENVIRONMENT=development      # development | production
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Modeling defaults
DEFAULT_TICKER=AAPL
DEFAULT_PERIOD=2y
DEFAULT_INTERVAL=1d
DEFAULT_HIDDEN_STATES=3
HMM_N_ITER=100
HMM_RANDOM_STATE=42
HMM_N_RESTARTS=8                  # random EM restarts; best log-likelihood wins
MODEL_SELECTION_MIN_STATES=2
MODEL_SELECTION_MAX_STATES=6
MAX_FORECAST_DAYS=30

# Caching — in-memory by default; set REDIS_URL for a shared cache across replicas
CACHE_ENABLED=true
CACHE_TTL_SECONDS=900
CACHE_MAX_ENTRIES=256
# REDIS_URL=redis://localhost:6379/0

# Rate limiting (per client = API key or IP)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Auth (optional) — comma-separated API keys; clients send X-API-Key.
# Leave empty to disable auth entirely (default for local/demo).
API_KEYS=

# Observability
METRICS_ENABLED=true
LOG_JSON=false                   # true → machine-readable JSON logs (production)

# Market-data resilience
DATA_FETCH_RETRIES=3
DATA_FETCH_BACKOFF_SECONDS=0.5
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_SECONDS=30
