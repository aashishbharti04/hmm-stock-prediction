# ----------------------------------------------------------------------------
# Backend configuration — copy to `.env` and adjust. NEVER commit a real .env.
# ----------------------------------------------------------------------------

# App
APP_NAME="HMM Stock Prediction API"
ENVIRONMENT=development      # development | production
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Modeling defaults
DEFAULT_TICKER=AAPL
DEFAULT_PERIOD=2y
DEFAULT_INTERVAL=1d
DEFAULT_HIDDEN_STATES=3
HMM_N_ITER=100
HMM_RANDOM_STATE=42
MAX_FORECAST_DAYS=30
