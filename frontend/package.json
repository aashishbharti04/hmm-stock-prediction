{
  "name": "hmm-stock-prediction-frontend",
  "version": "2.0.0",
  "private": true,
  "description": "Next.js dashboard for HMM-based stock-market regime detection and forecasting.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.7",
    "next": "^14.2.35",
    "next-themes": "0.4.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.15.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "20.17.10",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.5.15",
    "prettier": "3.8.4",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
