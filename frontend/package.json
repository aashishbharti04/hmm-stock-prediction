{
  "name": "hmm-stock-prediction-frontend",
  "version": "2.0.0",
  "private": true,
  "description": "Next.js dashboard for HMM-based stock-market regime detection and forecasting.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.7",
    "next": "^16.2.9",
    "next-themes": "0.4.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.15.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^25.9.3",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "autoprefixer": "10.4.20",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "postcss": "^8.5.15",
    "prettier": "3.8.4",
    "tailwindcss": "3.4.17",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
