# ============================================================================
#  Root .gitignore — covers Python backend + Node/Next.js frontend
# ============================================================================

# --- Secrets / environment --------------------------------------------------
.env
.env.*
!.env.example
*.local

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
.venv*/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.cover

# --- Node / Next.js ---------------------------------------------------------
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Editors / OS -----------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Playwright / E2E -------------------------------------------------------
playwright-report/
test-results/
playwright/.cache/

# --- Security / SBOM artifacts ----------------------------------------------
sbom.spdx.json
trivy-results.sarif

# --- Misc -------------------------------------------------------------------
coverage/
*.log
